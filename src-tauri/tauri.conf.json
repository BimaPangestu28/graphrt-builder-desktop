{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "graphrt",
  "version": "0.1.0",
  "identifier": "com.graphrt.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/check-node-sidecar.mjs && pnpm dev",
    "beforeBuildCommand": "node scripts/check-node-sidecar.mjs && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "graphrt",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#F4F4F5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "licenses/node-LICENSE.txt": "licenses/node-LICENSE.txt"
    },
    "category": "DeveloperTool",
    "shortDescription": "Build and run automation agents on your Mac"
  }
}
