<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Signed (hardened runtime) macOS builds: the bundled Node sidecar (graphrt-node)
  runs V8, which compiles JavaScript at run time and needs the first two exceptions.
  Plugins also ship native Node addons (e.g. sharp, @napi-rs/canvas, ssh2) that are
  signed by their authors or not at all, so library validation must be off for
  graphrt-node to load them. The app's own code does not rely on these.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
