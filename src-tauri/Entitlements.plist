<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Signed (hardened runtime) macOS builds. Up to 0.1.x the app bundled Node.js as a
  sidecar that inherited these exceptions (V8's JIT, unsigned native addons such as
  sharp). Node is now downloaded on demand into the app data folder and runs as its
  own process under its own signature: the Node.js project signs its release binaries
  with its Developer ID and hardened runtime plus allow-jit, allow-unsigned-executable-memory
  and disable-library-validation, so these entitlements of graphrt no longer apply to it
  (verified: a hardened parent without them starts the downloaded node, which loads sharp).
  The app's own code does not rely on them; they are kept for now so this change does
  not alter the signing setup, and can be dropped after a signed, notarized build is
  verified without them.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
